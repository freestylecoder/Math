<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>Chris Gardner</Authors>
    <PackageOutputPath>C:\dev\NuGet\Local\$(AssemblyName)</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ReadOnlySpanExtensions.fs" />
    <Compile Include="Helpers.fs" />
    <Compile Include="ParseBuddy.fs" />
    <Compile Include="Natural.fs" />
    <Compile Include="Integer.fs" />
    <Compile Include="Rational.fs" />
    <Compile Include="Real.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.403" />
  </ItemGroup>

</Project>
